{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@house-scanner-tools/*": ["./tools/house-scanner/*"]
    },
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src",
    "tools/house-scanner",
    "supabase/**/*.test.ts",
    "verification",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
